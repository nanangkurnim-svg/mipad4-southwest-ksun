+/*
+ * Low-latency mode for game streaming. When set, Venus runs at the top
+ * allowed clock and decoder DCVS is skipped, so each frame decodes as fast
+ * as the hardware allows instead of at the slowest clock that still keeps up
+ * with the stream (e.g. SVS for 1080p60). Takes effect from the next clock
+ * update. Userspace turns it on only while a streaming client is in front.
+ *
+ * fw_low_power_mode and sys_idle_indicator are sent to the firmware when
+ * the core starts (it unloads after msm_vidc_firmware_unload_delay idle), so
+ * changes apply from the next cold start of Venus.
+ */
+bool msm_vidc_low_latency;
+module_param_named(low_latency, msm_vidc_low_latency, bool, 0644);
+MODULE_PARM_DESC(low_latency, "Pin Venus at its top clock and skip decoder DCVS");
+module_param_named(fw_low_power_mode, msm_vidc_fw_low_power_mode, int, 0644);
+module_param_named(sys_idle_indicator, msm_vidc_sys_idle_indicator, bool, 0644);
