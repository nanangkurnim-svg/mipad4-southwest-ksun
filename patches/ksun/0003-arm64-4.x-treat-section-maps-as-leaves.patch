 // https://github.com/fuqiuluo/ovo/blob/f7da411458e87d32438dc14fce5a3313ed0c967e/ovo/mmuhack.c#L21
 
+// pmd_leaf()/pud_leaf() only exist from 5.7. arm64 4.x calls them
+// pmd_sect()/pud_sect(). Without them a 2M block mapping, which is how the
+// kernel maps its rodata (and sys_call_table) there, looks like a bad table
+// entry and the walk fails with -ENOENT.
+#if !defined(pmd_leaf) && defined(pmd_sect)
+#define pmd_leaf(pmd) pmd_sect(pmd)
+#endif
+#if !defined(pud_leaf) && defined(pud_sect)
+#define pud_leaf(pud) pud_sect(pud)
+#endif
+
 // Translate a kernel virtual address to a physical address by walking the
